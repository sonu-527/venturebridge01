# VentureBridge Backend Environment Configuration Example
# Copy this file to backend/.env for local overrides, or set these in Render Environment Variables.

# Server Port (Render injects $PORT automatically, local default is 8000)
PORT=8000

# Security: Secret key for JWT access tokens.
# IMPORTANT: Generate a strong, unique 32+ character random string for production!
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars

# CORS: Allowed origins for browser frontend requests (comma-separated)
ALLOWED_ORIGINS=https://venturebridge01.vercel.app,http://localhost:5173,http://localhost:5174
FRONTEND_URL=https://venturebridge01.vercel.app

# Database:
# For production persistence on Render: Create a Render PostgreSQL database and paste the Internal/External connection string here.
# DATABASE_URL=postgresql://venturebridge_user:your_password@dpg-xxxxxx.render.com/venturebridge_db
#
# If DATABASE_URL is omitted or empty, the backend runs on local SQLite:
SQLITE_DB_PATH=venturebridge.db

# Initial Seeding: Automatically seed default demo personas, startups, and opportunities if database is empty (true/false)
AUTO_SEED=true
